{
    "spacing": 15,
    
    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
         "cpu",
         "memory",
         "disk"
    ],

    "hyprland/workspaces": {
        "format": "{name}: {icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "urgent": "",
            "active": "",
            "default": ""
        }
    },


    "clock": {
        "format": "{:%A, %B %d, %Y - %I:%M %p}",
        "tooltip": false
    },

    "cpu": {
         "format": "{usage}% ",
         "tooltip": false
    },

    "memory": {
         "format": "{}% "
    },

    "disk": {
         "format": "{used} / {total} "
    }
}
